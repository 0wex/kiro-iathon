{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc -b ../../packages/api && tsdown",
		"build:node": "tsdown -c tsdown.node.config.ts",
		"start:node": "node dist-node/node.mjs",
		"build:lambda": "tsdown -c tsdown.lambda.config.ts",
		"check-types": "tsc -b ../../packages/api && tsc --noEmit",
		"test": "vitest run",
		"dev": "pnpm --filter @iathon-kiro/infra dev",
		"env:generate": "varlock codegen"
	},
	"dependencies": {
		"@iathon-kiro/api": "workspace:*",
		"@iathon-kiro/auth": "workspace:*",
		"@iathon-kiro/business": "workspace:*",
		"@iathon-kiro/db": "workspace:*",
		"@iathon-kiro/node-runtime": "workspace:*",
		"@orpc/server": "catalog:",
		"better-auth": "catalog:",
		"evlog": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@iathon-kiro/config": "workspace:*",
		"@iathon-kiro/infra": "workspace:*",
		"@types/node": "^26.4.1",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"varlock": "catalog:",
		"vitest": "catalog:"
	}
}
